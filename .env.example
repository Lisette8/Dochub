# Exemple de configuration d'environnement pour DocHub : copier en .env et remplir.
# Le fichier .env n'est jamais envoyé sur Git.

# Base Oracle
DB_NAME=FREEPDB1
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=1521
DB_ROOT_PASSWORD=

# Django
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
# Mettre DB_ENGINE=sqlite pour travailler / tester sans le conteneur Oracle
DB_ENGINE=oracle

# Facultatif
# ALLOWED_HOSTS=
# Ports ouverts sur le PC (à changer s'ils sont déjà pris)
# WEB_HOST_PORT=8000
# ORACLE_HOST_PORT=1521
# SUSPENSION_JOURS=7
# COMPTES_PAR_PAGE=10
# HISTORIQUE_TAILLE=10
